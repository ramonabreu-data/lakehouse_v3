# TEMPLATE de exemplo. Copie para o arquivo real (.env / vars.env) e preencha.
# Os endpoints usam nomes de servico da rede docker: validos de DENTRO do container.

# -----------------------------------------------------------------------------
# Dremio (conta de servico usada para CONSULTAR o lakehouse)
# -----------------------------------------------------------------------------
DREMIO_USERNAME=defina-o-usuario
DREMIO_PASSWORD=troque-por-um-valor-forte
DREMIO_ENDPOINT=dremio:9047
DREMIO_FLIGHT_ENDPOINT=dremio:32010

# -----------------------------------------------------------------------------
# Autenticacao do dashboard (Supabase GoTrue)
# -----------------------------------------------------------------------------
# AUTH_ENABLED=false desliga o login (modo dev).
AUTH_ENABLED=true
# Endpoint interno do GoTrue (nome de servico na rede docker "interna").
SUPABASE_URL=http://supabase-auth:9999
# Vazio: GoTrue acessado direto, sem gateway Kong.
SUPABASE_AUTH_PATH_PREFIX=
SUPABASE_ANON_KEY=
# Segredo dos JWT do GoTrue. DEVE ser identico ao JWT_SECRET do .env da stack.
# O app o usa para assinar um token service_role e chamar a Admin API do GoTrue
# (criar/remover usuarios). Fica so no servidor, nunca vai ao navegador.
JWT_SECRET=troque-por-um-valor-forte

# -----------------------------------------------------------------------------
# Usuario master (o unico que cria/remove usuarios pela interface).
# Criado automaticamente no primeiro boot, se ainda nao existir. Troque a senha.
# -----------------------------------------------------------------------------
AUTH_MASTER_EMAIL=voce@exemplo.com
AUTH_MASTER_PASSWORD=troque-por-um-valor-forte

# -----------------------------------------------------------------------------
# Cookie de sessao criptografado no navegador
# -----------------------------------------------------------------------------
# Chave do cookie (>= 32 caracteres). Gere a sua com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
COOKIE_SECRET=troque-por-um-valor-forte
COOKIE_NAME=dash_session
COOKIE_PREFIX=dash_auth_
COOKIE_MAX_AGE_DAYS=7
