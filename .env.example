# TEMPLATE de exemplo. Copie para .env e preencha.
# Evite $ & ) ! nas senhas: exigem escape em YAML/shell.

# -----------------------------------------------------------------------------
# Identidade do projeto (whitelabel)
# -----------------------------------------------------------------------------
# Define o nome do projeto Compose, o prefixo dos containers e o prefixo dos
# volumes. Para implantar em outro cliente, troque SO esta linha.
# Antes de trocar, confira que o nome esta livre:
#   docker volume ls | grep '^<nome>_' ; docker ps -a --format '{{.Names}}' | grep '^<nome>_'
PROJETO=plataforma

# Dominio-base do reverse proxy (subdominios: dashboard./dremio./minio./jupyter.).
# *.localhost resolve para 127.0.0.1 em Linux moderno.
DOMAIN=localhost

# -----------------------------------------------------------------------------
# Zonas do object store (buckets do MinIO)
# -----------------------------------------------------------------------------
# entrada   - aterrissagem: arquivos como chegam da origem, sem catalogo
# armazem   - warehouse unico do catalogo Iceberg/Nessie (tabelas gerenciadas)
# historico - cargas antigas, backup e material de descarte
ZONA_ENTRADA=entrada
ZONA_ARMAZEM=armazem
ZONA_HISTORICO=historico

# -----------------------------------------------------------------------------
# Credenciais
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=defina-o-usuario
MINIO_ROOT_PASSWORD=troque-por-um-valor-forte

POSTGRES_USER=defina-o-usuario
POSTGRES_PASSWORD=troque-por-um-valor-forte
POSTGRES_DB=ssp_db

MONGO_INITDB_ROOT_USERNAME=defina-o-usuario
MONGO_INITDB_ROOT_PASSWORD=troque-por-um-valor-forte

# -----------------------------------------------------------------------------
# Autenticacao do dashboard (Supabase GoTrue)
# -----------------------------------------------------------------------------
# Postgres dedicado do GoTrue (separado do postgres de dados da stack).
SUPABASE_DB_NAME=supabase_auth
SUPABASE_DB_USER=defina-o-usuario
SUPABASE_DB_PASSWORD=troque-por-um-valor-forte
# Segredo de assinatura dos JWT do GoTrue (>= 32 caracteres).
JWT_SECRET=troque-por-um-valor-forte
JWT_EXPIRY_SECONDS=3600
# GoTrue exposto no host (o app fala por dentro da rede: supabase-auth:9999).
SUPABASE_AUTH_PORT=9999
SUPABASE_PUBLIC_URL=http://localhost:9999
APP_PUBLIC_URL=https://dashboard.localhost
# Signup publico DESLIGADO: so o usuario master cria contas (via Admin API do
# GoTrue). Auto-confirmacao ligada (sem SMTP local) para as contas criadas pelo
# master ja entrarem sem confirmar e-mail.
SUPABASE_DISABLE_SIGNUP=true
SUPABASE_MAILER_AUTOCONFIRM=true

# -----------------------------------------------------------------------------
# JupyterLab: token de acesso (sem token = execucao de codigo aberta a quem
# alcancar a porta 8889). Gere o seu com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# -----------------------------------------------------------------------------
JUPYTER_TOKEN=gere-um-token
